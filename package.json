{
  "name": "cyber-security-portal-backend",
  "version": "1.0.0",
  "description": "Backend API for Cyber Security Learning Portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "deploy:all": "firebase deploy --only functions,hosting"
  },
  "keywords": [
    "cyber-security",
    "student-portal",
    "express",
    "mongodb",
    "api"
  ],
  "author": "Cyber Secure Team",
