  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.3.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "googleapis": "^181.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "mongoose": "^8.18.0",
    "nodemailer": "^7.0.6"
  },
  "devDependencies": {
    "firebase-tools": "^13.0.0",
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": "18"
  }
